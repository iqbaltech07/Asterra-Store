# ==============================================================================
# Asterra Store - Sales Portal - Environment Variables Template (.env.example)
# ==============================================================================

# Server Environment ('development' or 'production')
NODE_ENV=development
PORT=3002

# Backend API Service URL
# Development: http://localhost:8000
# Production:  https://api.asterrastore.biz.id
BACKEND_URL=http://localhost:8000

# Client App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_STORE_URL=http://localhost:3000

# Authentication & Session Verification (proxy.ts)
JWT_SECRET="your-jwt-secret-min32chars"
