# ==============================================================================
# Asterra Store - Sales Portal - Environment Variables Template (.env.example)
# ==============================================================================

# Server Environment ('development' or 'production')
NODE_ENV=development
PORT=3002

# Backend API Service URL
# Development: http://localhost:8000
# Production:  https://api.asterrastore.biz.id
BACKEND_URL=http://localhost:8000

# Client App URLs
# Development: http://localhost:3002
# Production:  https://sales.asterrastore.biz.id
NEXT_PUBLIC_APP_URL=http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:8000

# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Authentication
JWT_SECRET="asterra_jwt_secret_dev_change_in_production_min32chars"
