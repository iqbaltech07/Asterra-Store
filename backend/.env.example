# ==============================================================================
# Asterra Store - Core Backend (Python FastAPI) Environment Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Environment
# ------------------------------------------------------------------------------
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002,https://asterrastore.biz.id,https://admin.asterrastore.biz.id,https://sales.asterrastore.biz.id"

# ------------------------------------------------------------------------------
# 2. Database (Supabase PostgreSQL via SQLAlchemy ORM)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# ------------------------------------------------------------------------------
# 3. Security & JWT Authentication
# ------------------------------------------------------------------------------
SECRET_KEY="your-super-secret-jwt-signing-key-min-32-chars"
JWT_SECRET="your-super-secret-jwt-signing-key-min-32-chars"
ADMIN_SESSION_SECRET="your-admin-session-secret"
ADMIN_EMAIL="admin@asterra.store"
ADMIN_PASSWORD="AsterraAdmin#2026"

# ------------------------------------------------------------------------------
# 4. Payment Gateway (Tripay)
# ------------------------------------------------------------------------------
TRIPAY_API_KEY="DEV-your-tripay-api-key"
TRIPAY_PRIVATE_KEY="your-tripay-private-key"
TRIPAY_MERCHANT_CODE="T12345"
TRIPAY_IS_PRODUCTION=false

# ------------------------------------------------------------------------------
# 5. Cloud Media Storage (Vercel Blob)
# ------------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_token_placeholder"

# ------------------------------------------------------------------------------
# 6. Supplier Integration (VIP Reseller)
# ------------------------------------------------------------------------------
VIP_RESELLER_BASE_URL="https://vip-reseller.co.id/api"
VIP_RESELLER_API_ID="your_api_id"
VIP_RESELLER_API_KEY="your_api_key"
VIP_RESELLER_SIGN="your_signature"
VIP_RESELLER_SYNC_SECRET="your_sync_secret"

# ------------------------------------------------------------------------------
# 7. Transactional Email Notification (SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASS="your-smtp-password"
SMTP_FROM="Asterra Store <noreply@asterra.store>"

# ------------------------------------------------------------------------------
# 8. OAuth / Social Authentication (Optional)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
