# ==========================================
# Asterra Backend - Environment Variables Template
# ==========================================

NODE_ENV=development
PORT=4000
NEXT_PUBLIC_APP_URL=http://localhost:4000
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002"

# Database (Supabase / PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/asterra_store?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/asterra_store"

# Authentication & Security
JWT_SECRET="asterra_jwt_secret_dev_change_in_production_min32chars"
NEXTAUTH_SECRET="asterra_nextauth_secret_dev_change_in_production"
NEXTAUTH_URL="http://localhost:4000"
ADMIN_EMAIL="admin@asterra.store"
ADMIN_PASSWORD="AsterraAdmin#2026"
ADMIN_SESSION_SECRET="asterra_admin_sec_placeholder"
BETTER_AUTH_SECRET="better_auth_secret_placeholder"
BETTER_AUTH_URL="http://localhost:4000"

# Payment Gateway (Tripay)
TRIPAY_API_KEY="DEV-tripay-api-key-placeholder"
TRIPAY_PRIVATE_KEY="DEV-tripay-private-key-placeholder"
TRIPAY_MERCHANT_CODE="T12345"
TRIPAY_IS_PRODUCTION=false

# Transactional Email Notification (SMTP)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASS="placeholder-password"
SMTP_FROM="Asterra Store <noreply@asterra.store>"

# VIP Reseller Supplier Integration
VIP_RESELLER_BASE_URL="https://vip-reseller.co.id/api"
VIP_RESELLER_API_ID="placeholder_id"
VIP_RESELLER_API_KEY="placeholder_key"
VIP_RESELLER_SIGN="placeholder_sign"
VIP_RESELLER_SYNC_SECRET="placeholder_sync_secret"

# Vercel Blob Storage
BLOB_READ_WRITE_TOKEN="placeholder_blob_token"
