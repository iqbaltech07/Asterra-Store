ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002,https://staging.asterrastore.biz.id,https://staging.admin.asterrastore.biz.id,https://staging.sales.asterrastore.biz.id,https://staging.api.asterrastore.biz.id,https://asterrastore.biz.id,https://admin.asterrastore.biz.id,https://sales.asterrastore.biz.id"

DATABASE_URL="postgresql://user:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

JWT_SECRET="your-super-secret-jwt-signing-key-min-32-chars"
BETTER_AUTH_SECRET="your-better-auth-secret-min-32-chars"
ADMIN_EMAIL="admin@asterra.store"
ADMIN_PASSWORD="YourSecureAdminPassword123"

# LiPay Android Payment Listener Token
LIPAY_DEVICE_TOKEN="your-secure-lipay-device-token"

BLOB_READ_WRITE_TOKEN="vercel_blob_rw_your_token_here"

# Xaviera Store Upstream API Integration (https://xavierastore.com/api-docs.html)
XAVIERA_BASE_URL="https://xavierastore.com/api/v1"
XAVIERA_API_KEY="xvs_your_api_key_here"
XAVIERA_AUTO_FULFILLMENT="true"
XAVIERA_SANDBOX_MODE="false"

# Transactional Email (Resend HTTPS REST API or SMTP)
RESEND_API_KEY="re_your_resend_api_key_here"
RESEND_FROM="Asterra Store <onboarding@resend.dev>"
# Optional direct SMTP alternative (e.g. Gmail / Brevo / Custom SMTP)
# SMTP_HOST="smtp.resend.com"
# SMTP_PORT=587
# SMTP_USER="resend"
# SMTP_PASSWORD="re_your_smtp_password"

# Application Base URLs for Secure Password Recovery & Portal Links
ADMIN_URL="https://staging.admin.asterrastore.biz.id"
SALES_URL="https://staging.sales.asterrastore.biz.id"
STORE_URL="https://staging.asterrastore.biz.id"

GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

QSTASH_TOKEN=""
QSTASH_URL="https://qstash-us-east-1.upstash.io"
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""
INTERNAL_CRON_SECRET="your-internal-cron-secret-change-me"

BRANDFETCH_CLIENT_ID=""
BRANDFETCH_API_KEY=""

