// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id                 String       @id
  name               String
  categoryId         String       @map("category_id")
  categoryName       String       @map("category_name")
  brand              String
  price              Int
  priceFormatted     String       @map("price_formatted")
  description        String?      @db.Text
  features           String[]     @default([])
  status             String       @default("active") // "active" | "archived"
  stock              Int          @default(100)
  imageUrl           String?      @map("image_url") @db.Text
  popular            Boolean      @default(false)
  provider           String       @default("vip-reseller")
  providerCode       String?      @map("provider_code")
  providerName       String?      @map("provider_name")
  providerPrice      Int?         @map("provider_price")
  providerStatus     String?      @map("provider_status")
  lastProviderCheck  DateTime?    @map("last_provider_check")
  profitMargin       Int?         @map("profit_margin")
  profitPercentage   Int?         @map("profit_percentage")

  // Fitur Highlight Produk (Bisa diubah admin)
  guaranteeTitle     String?      @default("Garansi Penuh") @map("guarantee_title")
  guaranteeDesc      String?      @default("Jaminan ganti akun 100%") @map("guarantee_desc")
  processTitle       String?      @default("Proses Instan") @map("process_title")
  processDesc        String?      @default("1 - 15 menit selesai") @map("process_desc")
  privacyTitle       String?      @default("Akun Private") @map("privacy_title")
  privacyDesc        String?      @default("Ruang kerja aman & personal") @map("privacy_desc")

  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  orderItems         OrderItem[]

  @@index([status])
  @@index([categoryId])
  @@index([brand])
  @@index([providerCode])
  @@map("products")
}

model Order {
  id                String         @id @default(cuid())
  customerEmail     String         @map("customer_email")
  customerWhatsapp  String?        @map("customer_whatsapp")
  customerName      String?        @map("customer_name")
  customerNotes     String?        @map("customer_notes") @db.Text
  totalAmount       Int            @map("total_amount")
  rawAmount         Int?           @map("raw_amount")
  uniqueCode        Int?           @map("unique_code")
  paymentMode       String         @default("gateway") @map("payment_mode") // "gateway" | "manual"
  status            String         @default("pending") // "pending" | "processing" | "completed" | "cancelled"
  paymentMethod     String?        @map("payment_method")
  paymentReference  String?        @map("payment_reference")
  paymentStatus     String?        @map("payment_status")
  paidAt            DateTime?      @map("paid_at")
  expiresAt         DateTime?      @map("expires_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  referralCode      String?        @map("referral_code")
  salesPartnerId    String?        @map("sales_partner_id")
  salesPartner      SalesPartner?  @relation("OrderSalesPartner", fields: [salesPartnerId], references: [id])
  recruiterPartnerId String?       @map("recruiter_partner_id")
  recruiterPartner  SalesPartner?  @relation("OrderRecruiterPartner", fields: [recruiterPartnerId], references: [id])

  items             OrderItem[]
  logs              OrderLog[]
  commission        Commission?
  profitLedger      ProfitLedger?

  @@index([customerEmail])
  @@index([status])
  @@index([paymentMode])
  @@index([expiresAt])
  @@index([createdAt])
  @@index([referralCode])
  @@index([salesPartnerId])
  @@map("orders")
}

model PaymentSetting {
  id                    String   @id @default("default_setting")
  mode                  String   @default("gateway") // "gateway" | "manual"
  
  // Rekening Bank Manual Toko
  bankName              String?  @default("Bank Central Asia (BCA)") @map("bank_name")
  bankAccountNumber     String?  @default("8965123456") @map("bank_account_number")
  bankAccountName       String?  @default("Asterra Store Official") @map("bank_account_name")

  // QRIS Manual Toko
  qrisImageUrl          String?  @map("qris_image_url") @db.Text
  qrisMerchantName      String?  @default("ASTERRA STORE QRIS") @map("qris_merchant_name")

  // E-Wallet DANA Manual
  danaNumber            String?  @default("081234567890") @map("dana_number")
  danaAccountName       String?  @default("Asterra Store") @map("dana_account_name")

  // WhatsApp Admin untuk Konfirmasi
  confirmationWhatsapp  String?  @default("081234567890") @map("confirmation_whatsapp")
  instructions          String?  @db.Text

  // CS Kontak & Dukungan
  csEmail               String?  @default("support@asterra.store") @map("cs_email")
  csWhatsappNumbers     String[] @default(["081234567890"]) @map("cs_whatsapp_numbers")

  // Fitur Keamanan Anti-Fraud
  enableUniqueCode      Boolean  @default(true) @map("enable_unique_code")
  orderExpiryHours      Int      @default(24) @map("order_expiry_hours")

  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("payment_settings")
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String   @map("order_id")
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String   @map("product_id")
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productName String   @map("product_name")
  price       Int
  quantity    Int      @default(1)
  targetEmail String?  @map("target_email")
  targetPhone String?  @map("target_phone")
  duration    String?  @map("duration")

  @@map("order_items")
}

model OrderLog {
  id              String   @id @default(cuid())
  orderId         String   @map("order_id")
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor           String   @default("system") // "admin" | "tripay_webhook" | "customer" | "system"
  action          String   // "order_created" | "status_updated" | "payment_received" | "cancelled" | "note_added"
  previousStatus  String?  @map("previous_status")
  newStatus       String?  @map("new_status")
  notes           String?  @db.Text
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([orderId])
  @@index([actor])
  @@index([createdAt])
  @@map("order_logs")
}

// ==========================================
// Sales & Referral Models
// ==========================================

model SalesPartner {
  id                String       @id @default(cuid())
  name              String
  email             String       @unique
  whatsapp          String
  code              String       @unique
  tier              String       @default("Standard (10%)")
  rate              Int          @default(10)
  totalClicks       Int          @default(0) @map("total_clicks")
  bankName          String?      @map("bank_name")
  bankAccount       String?      @map("bank_account")
  status            String       @default("active") // "active" | "pending" | "suspended" | "inactive"
  
  referredById      String?      @map("referred_by_id")
  referredBy        SalesPartner? @relation("SponsorToPartner", fields: [referredById], references: [id])
  downlines         SalesPartner[] @relation("SponsorToPartner")

  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  orders            Order[]      @relation("OrderSalesPartner")
  recruitedOrders   Order[]      @relation("OrderRecruiterPartner")
  commissions       Commission[] @relation("PartnerCommissions")
  networkBonuses    Commission[] @relation("RecruiterCommissions")
  payoutRequests    PayoutRequest[]

  @@index([email])
  @@index([code])
  @@index([referredById])
  @@map("sales_partners")
}

model Commission {
  id                  String       @id @default(cuid())
  orderId             String       @unique @map("order_id")
  order               Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  partnerId           String       @map("partner_id")
  partner             SalesPartner @relation("PartnerCommissions", fields: [partnerId], references: [id])
  
  recruiterId         String?      @map("recruiter_id")
  recruiter           SalesPartner? @relation("RecruiterCommissions", fields: [recruiterId], references: [id])
  
  orderTotal          Int          @map("order_total")
  netRevenue          Int          @map("net_revenue")
  costOfGoods         Int          @map("cost_of_goods")
  transactionProfit   Int          @map("transaction_profit")
  
  commissionRate      Int          @map("commission_rate")
  commissionAmount    Int          @map("commission_amount")
  
  bonusRate           Int          @default(0) @map("bonus_rate")
  bonusAmount         Int          @default(0) @map("bonus_amount")

  status              String       @default("pending") // "pending" | "final" | "reversed" | "paid"
  reversalReason      String?      @map("reversal_reason") @db.Text
  
  holdingUntil        DateTime     @map("holding_until")
  releasedAt          DateTime?    @map("released_at")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  @@index([partnerId])
  @@index([recruiterId])
  @@index([status])
  @@index([holdingUntil])
  @@map("commissions")
}

model ProfitLedger {
  id                        String       @id @default(cuid())
  orderId                   String       @unique @map("order_id")
  order                     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  customerEmail             String       @map("customer_email")
  customerName              String?      @map("customer_name")
  
  productId                 String       @map("product_id")
  productNames              String       @map("product_names")
  
  salesId                   String?      @map("sales_id")
  salesName                 String?      @map("sales_name")
  referralCode              String?      @map("referral_code")
  
  recruiterSalesId          String?      @map("recruiter_sales_id")
  recruiterSalesName        String?      @map("recruiter_sales_name")
  
  saleCommissionRate        Float        @map("sale_commission_rate")
  recruitmentBonusRate      Float        @map("recruitment_bonus_rate")
  
  sellingPrice              Int          @map("selling_price")
  customerReferralDiscount  Int          @default(0) @map("customer_referral_discount")
  netRevenue                Int          @map("net_revenue")
  costOfGoods               Int          @map("cost_of_goods")
  paymentFee                Int          @map("payment_fee")
  otherDirectCost           Int          @map("other_direct_cost")
  directTransactionCost     Int          @map("direct_transaction_cost")
  transactionProfit         Int          @map("transaction_profit")
  
  salesCommission           Int          @map("sales_commission")
  recruitmentBonus          Int          @map("recruitment_bonus")
  
  profitDistribution        Int          @map("profit_distribution")
  ceoShare                  Int          @map("ceo_share")
  cooShare                  Int          @map("coo_share")
  businessReserve           Int          @map("business_reserve")
  
  status                    String       @default("pending") // "pending" | "available" | "withdrawn" | "reversed"
  holdingUntil              DateTime     @map("holding_until")
  releasedAt                DateTime?    @map("released_at")
  reversalReason            String?      @map("reversal_reason") @db.Text
  
  createdAt                 DateTime     @default(now()) @map("created_at")
  updatedAt                 DateTime     @updatedAt @map("updated_at")

  @@index([status])
  @@index([holdingUntil])
  @@map("profit_ledgers")
}

model PayoutRequest {
  id                String       @id @default(cuid())
  partnerId         String       @map("partner_id")
  partner           SalesPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  amount            Int
  bankName          String       @map("bank_name")
  bankAccount       String       @map("bank_account")
  bankAccountName   String       @map("bank_account_name")
  status            String       @default("pending") // "pending" | "completed" | "rejected"
  notes             String?      @db.Text
  processedAt       DateTime?    @map("processed_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  @@index([partnerId])
  @@index([status])
  @@map("payout_requests")
}

model ReferralDiscountUsage {
  id                String       @id @default(cuid())
  orderId           String       @unique @map("order_id")
  customerEmail     String       @map("customer_email")
  customerPhone     String?      @map("customer_phone")
  referralCode      String       @map("referral_code")
  discountAmount    Int          @map("discount_amount")
  createdAt         DateTime     @default(now()) @map("created_at")

  @@index([customerEmail])
  @@index([customerPhone])
  @@index([referralCode])
  @@map("referral_discount_usages")
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  role          String    @default("customer") // "customer" | "admin"
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  idToken               String?   @map("id_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@unique([providerId, accountId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("verification")
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  role         String   @default("admin") // "superadmin" | "admin"
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("admin_users")
}

model PromoCode {
  id              String       @id
  code            String       @unique
  description     String?
  discountType    String       @default("percentage") @map("discount_type")
  discountValue   Int          @map("discount_value")
  maxDiscount     Int?         @map("max_discount")
  minOrderAmount  Int          @default(0) @map("min_order_amount")
  usageLimit      Int?         @map("usage_limit")
  usedCount       Int          @default(0) @map("used_count")
  perUserLimit    Int          @default(1) @map("per_user_limit")
  startDate       DateTime?    @default(now()) @map("start_date")
  expiresAt       DateTime?    @map("expires_at")
  isActive        Boolean      @default(true) @map("is_active")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at")

  @@index([code])
  @@index([isActive])
  @@map("promo_codes")
}

model PromoUsage {
  id              String       @id
  promoCodeId     String       @map("promo_code_id")
  orderId         String?      @map("order_id")
  userEmail       String       @map("user_email")
  discountApplied Int          @map("discount_applied")
  createdAt       DateTime     @default(now()) @map("created_at")

  @@index([userEmail])
  @@index([promoCodeId, userEmail])
  @@map("promo_usages")
}
