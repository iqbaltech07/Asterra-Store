# ==============================================================================
# Asterra Storefront (Customer) - Environment Variables Template (.env.example)
# ==============================================================================

# Server Environment ('development' or 'production')
NODE_ENV=development
PORT=3000

# Backend API Service URL
# Development: http://localhost:8000
# Production:  https://api.asterrastore.biz.id
BACKEND_URL=http://localhost:8000

# Client App URLs
# Development: http://localhost:3000
# Production:  https://asterrastore.biz.id
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SALES_URL=http://localhost:3002

# Database (Supabase PostgreSQL via SQLAlchemy / Direct)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Authentication & Session
JWT_SECRET="asterra_jwt_secret_dev_change_in_production_min32chars"
NEXTAUTH_SECRET="asterra_nextauth_secret_dev_change_in_production"
NEXTAUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET="asterra_better_auth_secret_dev_change_in_production"
BETTER_AUTH_URL=http://localhost:3000
ADMIN_SESSION_SECRET="asterra_admin_sec_placeholder"

# OAuth (Google)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
