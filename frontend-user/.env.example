# ==============================================================================
# Asterra Storefront (Customer) - Environment Variables Template (.env.example)
# ==============================================================================

# Server Environment ('development' or 'production')
NODE_ENV=development
PORT=3000

# Backend API Service URL
# Development: http://localhost:8000
# Production:  https://api.asterrastore.biz.id
BACKEND_URL=http://localhost:8000

# Client App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SALES_URL=http://localhost:3002

# Database (Supabase PostgreSQL via Prisma ORM for Better-Auth & Customer Account)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Authentication & Session (Better-Auth & proxy.ts)
BETTER_AUTH_SECRET="your-better-auth-secret-min32chars"
BETTER_AUTH_URL=http://localhost:3000
JWT_SECRET="your-jwt-secret-min32chars"

# OAuth (Google Login Pelanggan)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
