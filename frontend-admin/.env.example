# ==============================================================================
# Asterra Store - Admin Console - Environment Variables Template (.env.example)
# ==============================================================================

# Server Environment ('development' or 'production')
NODE_ENV=development
PORT=3001

# Backend API Service URL
# Development: http://localhost:8000
# Production:  https://api.asterrastore.biz.id
BACKEND_URL=http://localhost:8000

# Client App URLs
# Development: http://localhost:3001
# Production:  https://admin.asterrastore.biz.id
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:8000

# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Authentication & Admin Access
JWT_SECRET="asterra_jwt_secret_dev_change_in_production_min32chars"
ADMIN_EMAIL="admin@asterra.store"
ADMIN_PASSWORD="AsterraAdmin#2026"
ADMIN_SESSION_SECRET="asterra_admin_sec_placeholder"
