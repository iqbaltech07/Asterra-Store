# ==============================================================================
# Asterra Store - Admin Console - Environment Variables Template (.env.example)
# ==============================================================================

# Server Environment ('development' or 'production')
NODE_ENV=development
PORT=3001

# Backend API Service URL
# Development: http://localhost:8000
# Production:  https://api.asterrastore.biz.id
BACKEND_URL=http://localhost:8000

# Client App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_STORE_URL=http://localhost:3000
NEXT_PUBLIC_SALES_URL=http://localhost:3002

# Authentication & Session Verification (proxy.ts)
ADMIN_SESSION_SECRET="your-admin-session-secret-min32chars"
JWT_SECRET="your-jwt-secret-min32chars"
