{
  "name": "asterra-store-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Asterra Store Multi-Project Decoupled Architecture (User Storefront, Admin Suite, Sales Console, Backend API)",
  "workspaces": [
    "frontend-user",
    "frontend-admin",
    "frontend-sales",
    "backend"
  ],
  "scripts": {
    "dev:user": "npm --prefix frontend-user run dev",
    "dev:admin": "npm --prefix frontend-admin run dev",
    "dev:sales": "npm --prefix frontend-sales run dev",
    "dev:backend": "npm --prefix backend run dev",
    "dev:fastapi": "cd backend && uvicorn app.main:app --reload --port 8000",
    "build:user": "npm --prefix frontend-user run build",
    "build:admin": "npm --prefix frontend-admin run build",
    "build:sales": "npm --prefix frontend-sales run build",
    "build:backend": "npm --prefix backend run build",
    "build:all": "npm run build:user && npm run build:admin && npm run build:sales && npm run build:backend",
    "lint": "npm --prefix frontend-user run lint",
    "export:excel": "node scripts/generate-product-excel.js"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@gsap/react": "^2.1.2",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-select": "^2.3.7",
    "@tanstack/react-query": "^5.103.2",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.6",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^0.454.0",
    "next": "^15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.4",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.19",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.20.0",
    "eslint-config-next": "^15.1.7",
    "exceljs": "^4.4.0",
    "postcss": "^8.4.49",
    "prettier": "^3.5.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  },
  "keywords": [
    "asterra",
    "store",
    "frontend-user",
    "frontend-admin",
    "frontend-sales",
    "backend"
  ],
  "author": "dev.iqbal007@gmail.com",
  "license": "ISC"
}
